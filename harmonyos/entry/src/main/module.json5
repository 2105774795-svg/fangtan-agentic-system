{
  "module": {
    "name":"entry","type":"entry","description":"$string:module_desc","mainElement":"EntryAbility",
    "deviceTypes":["phone","tablet"],"deliveryWithInstall":true,"installationFree":false,"pages":"$profile:main_pages",
    "abilities":[{
      "name":"EntryAbility","srcEntry":"./ets/entryability/EntryAbility.ets","label":"$string:app_name",
      "icon":"$media:app_icon","exported":true,"launchType":"singleton","backgroundModes":["audioRecording"],
      "skills":[{"entities":["entity.system.home"],"actions":["ohos.want.action.home"]}]
    }],
    "requestPermissions":[
      {"name":"ohos.permission.INTERNET"},
      {"name":"ohos.permission.KEEP_BACKGROUND_RUNNING"},
      {"name":"ohos.permission.MICROPHONE","reason":"$string:microphone_reason","usedScene":{"abilities":["EntryAbility"],"when":"always"}}
    ]
  }
}
