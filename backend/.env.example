KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
# 可选：提纲独立使用的模型。默认沿用 KIMI_MODEL；K3 短提示自动使用低推理强度
KIMI_OUTLINE_MODEL=kimi-k3
DASHSCOPE_API_KEY=
DASHSCOPE_FILETRANS_MODEL=qwen-audio-3.0-asr-flash-filetrans
DASHSCOPE_FLASH_MODEL=qwen-audio-3.0-asr-flash
DASHSCOPE_FLASH_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
FANGTAN_PORT=18995
FANGTAN_DATA_DIR=../data
# 本机单人使用设为 false；设为 true 恢复员工登录与共享权限
FANGTAN_AUTH_ENABLED=true
# 与会议龙虾共用的员工中心地址；服务器内网默认 127.0.0.1:3003
AUTH_API_URL=http://127.0.0.1:3003
# 公网 HTTPS 地址会启用 filetrans；本地地址会自动改用 Base64 同步转写
FANGTAN_PUBLIC_BASE=http://127.0.0.1:18995
FANGTAN_MAX_AUDIO_BYTES=20971520
# 已有材料导入上限：音频 200MB、文字稿 20MB
FANGTAN_MAX_IMPORT_AUDIO_BYTES=209715200
FANGTAN_MAX_IMPORT_TEXT_BYTES=20971520
# 可选发布探针；使用时设置自己的随机令牌
DEV_PROGRESS_TOKEN=
# 可选使用量统计，默认关闭。仅在明确同意后填入自己的统计服务地址。
# 启用后会发送使用人姓名、纪要事件 ID 和产品标识；本地单人模式始终不发送。
TEAMFLOW_USAGE_URL=
# 产品 ID 可留空，此时使用产品名称。
TEAMFLOW_PRODUCT_ID=
TEAMFLOW_PRODUCT_NAME=访谈-体察Agentic系统
